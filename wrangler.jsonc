{
  "name": "jeu-escp",
  "main": "src/worker.ts",
  "compatibility_date": "2025-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": { "directory": "./public", "binding": "ASSETS", "not_found_handling": "none" },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "Room" },
      { "name": "DSCG_SALONS", "class_name": "DscgSalon" },
      { "name": "DSCG_RECORDS", "class_name": "DscgRecords" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] },
    { "tag": "v2", "new_sqlite_classes": ["DscgSalon", "DscgRecords"] }
  ]
}
